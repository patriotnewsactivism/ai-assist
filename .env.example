# ─── Required ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here

# ─── Optional providers (unlock more agent choices) ─────────────
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# ─── Optional features ───────────────────────────────────────────
TAVILY_API_KEY=your_tavily_key_here        # enables live web search
GITHUB_TOKEN=your_github_pat_here          # enables repo import + PR push

# ─── Server ──────────────────────────────────────────────────────
PORT=5000

# ─── Security (REQUIRED — the server refuses to start without these) ───
# Browser login key (min 24 chars) + cookie signing secret (min 32 chars):
THINKTANK_ACCESS_KEY=
THINKTANK_SESSION_SECRET=
# Machine callers send `Authorization: Bearer <key>`. Comma-separated `id:key` (key min 24 chars):
THINKTANK_API_KEYS=
# Local dev only; refused when NODE_ENV=production:
# THINKTANK_AUTH=disabled
# Rate-limit overrides (defaults shown):
# THINKTANK_RL_DEBATE_PER_HOUR=10        # POST /api/debate per principal
# THINKTANK_MAX_CONCURRENT_DEBATES=2     # simultaneous running debates, server-wide
# THINKTANK_RL_HEAVY_PER_10M=30          # repo import/push, uploads, fetch-url
# THINKTANK_RL_TTS_PER_10M=120
# THINKTANK_RL_GENERAL_PER_10M=300       # everything else under /api
# THINKTANK_RL_PREAUTH_PER_10M=600       # per IP, before auth
# THINKTANK_RL_LOGIN_FAILS=5             # failed logins per IP per 15 min
